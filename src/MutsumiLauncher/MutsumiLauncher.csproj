<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MutsumiLauncher</RootNamespace>
    <AssemblyName>MutsumiLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**\*" />
    <Resource Include="Assets\**\*" Exclude="Assets\mcmod-zh.json.gz" />
    <!-- MC百科译名表（离线，来自 tools/mcmod-crawler），走嵌入资源方便直接读流 -->
    <EmbeddedResource Include="Assets\mcmod-zh.json.gz" />
    <!-- 全量百科表（31432 条，含没有中文名的），给 mcmod 匹配索引用 -->
    <EmbeddedResource Include="Assets\mcmod-all.json.gz" />
  </ItemGroup>

  <!-- 内核 zip 一起打进安装包：首次启动不用再下 22 MB。
       仓库里不放这个文件（.gitignore），构建前用 tools/get-core.ps1 拉一次。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\core\mihomo.zip')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\tools\core\mihomo.zip"
             Link="core\mihomo.zip"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 精简版 Windows 可能没有 VC++ 运行库：发布时放进程序目录，避免“缺少 vcruntime140.dll” -->
  <Target Name="CopyVCRuntime" AfterTargets="Publish">
    <ItemGroup>
      <VCRuntimeDll Include="$(WINDIR)/System32/vcruntime140.dll" />
      <VCRuntimeDll Include="$(WINDIR)/System32/vcruntime140_1.dll" />
      <VCRuntimeDll Include="$(WINDIR)/System32/msvcp140.dll" />
      <VCRuntimeDll Include="$(WINDIR)/System32/msvcp140_1.dll" />
      <VCRuntimeDll Include="$(WINDIR)/System32/msvcp140_2.dll" />
      <VCRuntimeDll Include="$(WINDIR)/System32/concrt140.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VCRuntimeDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(VCRuntimeDll.Identity)')" />
  </Target>

</Project>
