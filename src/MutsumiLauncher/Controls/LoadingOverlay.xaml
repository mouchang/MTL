<UserControl x:Class="MutsumiLauncher.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Background="#4DFFFFFF">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="44" Height="44" HorizontalAlignment="Center">
            <Ellipse Stroke="#40FFFFFF" StrokeThickness="3" />
            <Path Data="M 22,4 A 18,18 0 1 1 4,22" Stroke="{StaticResource AccentDeep}"
                  StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="Spin" Angle="0" />
                </Path.RenderTransform>
            </Path>
        </Grid>
        <TextBlock x:Name="LabelText" Text="加载中…" HorizontalAlignment="Center"
                   Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource InkSoft}" />
    </StackPanel>
</UserControl>
