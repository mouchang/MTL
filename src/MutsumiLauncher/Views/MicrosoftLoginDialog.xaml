<Window x:Class="MutsumiLauncher.Views.MicrosoftLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软登录" Width="480" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}">

    <Border x:Name="Card" Background="#F9FFFFFF" CornerRadius="20" Padding="24,20" BorderBrush="#88FFFFFF"
            BorderThickness="1" Opacity="0" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.24"
                              Color="#FF2E4A38" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="18" />
        </Border.RenderTransform>

        <StackPanel>
            <Grid>
                <TextBlock Text="微软登录" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" />
                <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                        Content="&#xE711;" Click="Cancel_Click" ToolTip="关闭" />
            </Grid>

            <TextBlock x:Name="HintText" Text="正在获取设备码…" FontSize="13"
                       Foreground="{StaticResource InkSoft}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="设备码（已自动复制到剪贴板）" FontSize="12"
                           Foreground="{StaticResource InkMute}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F2F7F3" CornerRadius="10" Padding="14,6">
                        <TextBlock x:Name="CodeText" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="复制"
                            Width="72" Height="34" Margin="8,0,0,0" Click="CopyCode_Click" />
                </Grid>

                <TextBlock Text="验证链接（已自动在浏览器打开）" FontSize="12"
                           Foreground="{StaticResource InkMute}" Margin="0,12,0,0" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F2F7F3" CornerRadius="10" Padding="14,8">
                        <TextBlock x:Name="LinkText" FontSize="13"
                                   Foreground="{StaticResource AccentDeep}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="复制"
                            Width="72" Height="34" Margin="8,0,0,0" Click="CopyLink_Click" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="打开"
                            Width="72" Height="34" Margin="8,0,0,0" Click="OpenBrowser_Click" />
                </Grid>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource InkMute}"
                       Margin="0,10,0,0" TextWrapping="Wrap" />

            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="96" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
