<Window x:Class="MutsumiLauncher.Views.MicrosoftLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软登录" Width="440" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}">

    <Border Background="#F7FFFFFF" CornerRadius="18" Padding="24,20" BorderBrush="#88FFFFFF"
            BorderThickness="1" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.22"
                              Color="#FF2E4A38" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="微软登录" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" />

            <TextBlock x:Name="HintText" Text="正在获取设备码…" FontSize="13"
                       Foreground="{StaticResource InkSoft}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <Border x:Name="CodePanel" Background="#F2F7F3" CornerRadius="12" Padding="14"
                    Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="在浏览器打开下面的网址，输入代码并授权：" FontSize="12"
                               Foreground="{StaticResource InkSoft}" />
                    <TextBlock x:Name="LinkText" FontSize="13" Foreground="{StaticResource AccentDeep}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="CodeText" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                    <Button Content="打开浏览器" Style="{StaticResource SecondaryButton}" Height="30"
                            Margin="0,8,0,0" HorizontalAlignment="Center" Click="OpenBrowser_Click" />
                </StackPanel>
            </Border>

            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="96" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
