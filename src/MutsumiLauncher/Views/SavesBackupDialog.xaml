<Window x:Class="MutsumiLauncher.Views.SavesBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mutsumi Launcher"
        Width="560" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="24">
        <Border Background="#F7FFFFFF" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270"
                                  Opacity="0.25" Color="#FF1B2B22" />
            </Border.Effect>

            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SummaryText" Grid.Row="1" Style="{StaticResource Caption}"
                           Margin="0,6,0,10" />

                <Border Grid.Row="2" Background="#66FFFFFF" CornerRadius="12" Padding="14,6">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="BackupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#1A000000"
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="14"
                                                               Foreground="{StaticResource Ink}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                   Foreground="{StaticResource InkMute}" />
                                                        <TextBlock Text="{Binding PathText}" FontSize="11"
                                                                   Foreground="{StaticResource InkMute}"
                                                                   Margin="10,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Content="还原" Height="30" Padding="12,0"
                                                            Margin="0,0,8,0" Tag="{Binding}"
                                                            Click="Restore_Click" />
                                                    <Button Style="{StaticResource GhostButton}"
                                                            Content="删除" Height="30" Padding="12,0"
                                                            Tag="{Binding}" Click="Delete_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyText" Text="还没有备份。回到存档页点「备份」，给这个世界拍张快照。"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                               Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="关闭" Width="88"
                            HorizontalAlignment="Right" Click="Close_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
