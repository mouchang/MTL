<UserControl x:Class="MutsumiLauncher.Views.FolderBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Background="#33000000" MouseDown="Backdrop_MouseDown">
        <Border Margin="60,50,60,50" CornerRadius="22" Background="#FAFFFFFF"
                BorderBrush="#88FFFFFF" BorderThickness="1" Padding="22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.22"
                                  Color="#FF2E4A38" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock x:Name="TitleText" Text="文件夹" Style="{StaticResource H1}" />
                    <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                            Content="&#xE711;" Click="Close_Click" ToolTip="关闭" />
                </Grid>

                <TextBlock x:Name="PathText" Grid.Row="1" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" TextTrimming="CharacterEllipsis" />

                <Border Grid.Row="2" Background="#F2F7FBF4" CornerRadius="12" Padding="6">
                    <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent"
                             MouseDoubleClick="EntryList_MouseDoubleClick"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Foreground="{StaticResource AccentDeep}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource Ink}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                                               Foreground="{StaticResource InkMute}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="EmptyText" Grid.Row="2" Text="（空文件夹）"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="上一级" Width="100"
                            Click="Up_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="刷新" Width="100"
                            Margin="10,0,0,0" Click="Refresh_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="在资源管理器中打开" Width="170"
                            Margin="10,0,0,0" Click="OpenInExplorer_Click" />
                    <TextBlock x:Name="HintText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="14,0,0,0" Text="双击文件夹进入，双击文件用系统程序打开。" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
