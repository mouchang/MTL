<UserControl x:Class="MutsumiLauncher.Views.Pages.DownloadSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                    <TextBlock Text="返回" FontSize="13" Foreground="{StaticResource InkSoft}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="设置 / 下载源" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="10,0,0,0" />
        </StackPanel>

        <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="原版资源" Style="{StaticResource H2}" />
                <TextBlock Text="版本清单、版本 JSON、客户端、依赖库、资源文件。" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" />

                <Button x:Name="VanillaOfficial" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="VanillaOfficial_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="官方源" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Mojang（piston-meta / launcher.mojang.com），国内可能较慢"
                                       FontSize="11" Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="VanillaOfficialCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="VanillaMirror" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="VanillaMirror_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="镜像源（BMCLAPI）" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="bmclapi2.bangbang93.com，国内加速，推荐" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="VanillaMirrorCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="社区资源" Style="{StaticResource H2}" />
                <TextBlock Text="Modrinth 的搜索接口、项目文件与图标。" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" />

                <Button x:Name="ModOfficial" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="ModOfficial_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="官方源" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="api.modrinth.com / cdn.modrinth.com" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ModOfficialCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="ModMirror" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="ModMirror_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="镜像源（MCIM）" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="mod.mcimirror.top，国内加速，推荐" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ModMirrorCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="切换后立即生效，新的下载请求会使用所选源；已经下载好的文件不会重新下载。" />

        <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="网络代理" Style="{StaticResource H2}" />
                <TextBlock Text="自动模式会在系统代理可用时使用代理，否则直连。" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" />

                <Button x:Name="ProxyAuto" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="ProxyAuto_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自动（推荐）" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="系统代理可用时走代理，否则直连" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ProxyAutoCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="ProxyDirect" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="ProxyDirect_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="直接连接" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="不使用任何代理，镜像源可直连" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ProxyDirectCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="ProxySystem" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="ProxySystem_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.4*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="跟随系统代理" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="使用 Windows 的代理设置" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ProxySystemCheck" Grid.Column="2" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="ProxyCustom" Style="{StaticResource GhostButton}" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="ProxyCustom_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自定义代理" FontSize="14" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="例如 Clash 的 127.0.0.1:7890" FontSize="11"
                                       Foreground="{StaticResource InkMute}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ProxyCustomCheck" Grid.Column="1" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Grid x:Name="CustomProxyRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProxyHostBox" Style="{StaticResource SheetTextBox}" Height="34" />
                    <TextBox x:Name="ProxyPortBox" Grid.Column="1" Style="{StaticResource SheetTextBox}"
                             Height="34" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="应用"
                            Width="80" Height="34" Margin="8,0,0,0" Click="ApplyProxy_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ProxyHint" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="网络代理修改后，重启启动器生效。" />

        <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="全接口 CDN（自定义反代）" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="默认走 https://mtl.dpdns.org。所有下载接口（原版、Modrinth、Fabric、Forge/NeoForge）都会改写为「前缀/原host/路径」；某个 host 被 CDN 拒绝时自动回退直连。留空则全部直连。" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VanillaCdnBox" Style="{StaticResource SheetTextBox}" Height="34" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="保存"
                            Width="80" Height="34" Margin="8,0,0,0" Click="SaveCdn_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
