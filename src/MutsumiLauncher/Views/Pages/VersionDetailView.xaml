<UserControl x:Class="MutsumiLauncher.Views.Pages.VersionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                    <TextBlock Text="返回" FontSize="13" Foreground="{StaticResource InkSoft}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="BreadcrumbText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="10,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22,18">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/grass.png" Width="52" Height="52"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontSize="22" Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="VersionCaption" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="22,14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="安装加载器（可选）" Style="{StaticResource H2}" Margin="0,0,0,4" />
                <TextBlock Text="Fabric / Forge / NeoForge 互不兼容，只能选择其中一个。"
                           Style="{StaticResource Caption}" Margin="0,0,0,8" />

                <!-- Fabric -->
                <Button x:Name="FabricRow" Style="{StaticResource GhostButton}" Padding="8,10"
                        HorizontalContentAlignment="Stretch" Click="Fabric_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fabric" FontSize="14" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="FabricStatus" Grid.Column="1" Text="可以添加" FontSize="12"
                                   Foreground="{StaticResource InkMute}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FabricChevron" Grid.Column="2" Text="&#xE76C;"
                                   FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource InkMute}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Border x:Name="FabricVersionsPanel" Visibility="Collapsed" Margin="8,0,8,8">
                    <StackPanel>
                        <TextBlock x:Name="FabricVersionsHint" Style="{StaticResource Caption}"
                                   Margin="0,0,0,6" Text="正在获取 Fabric 版本…" />
                        <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="FabricVersions" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Forge -->
                <Button x:Name="ForgeRow" Style="{StaticResource GhostButton}" Padding="8,10"
                        HorizontalContentAlignment="Stretch" Click="UnsupportedLoader_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Forge" FontSize="14" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="ForgeStatus" Grid.Column="1" Text="可以添加" FontSize="12"
                                   Foreground="{StaticResource InkMute}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="{StaticResource InkMute}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- NeoForge -->
                <Button x:Name="NeoForgeRow" Style="{StaticResource GhostButton}" Padding="8,10"
                        HorizontalContentAlignment="Stretch" Click="UnsupportedLoader_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NeoForge" FontSize="14" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="NeoForgeStatus" Grid.Column="1" Text="可以添加" FontSize="12"
                                   Foreground="{StaticResource InkMute}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="{StaticResource InkMute}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- OptiFine -->
                <Button x:Name="OptiFineRow" Style="{StaticResource GhostButton}" Padding="8,10"
                        HorizontalContentAlignment="Stretch" Click="UnsupportedLoader_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OptiFine" FontSize="14" Foreground="{StaticResource Ink}" />
                        <TextBlock Grid.Column="1" Text="暂未接入" FontSize="12"
                                   Foreground="{StaticResource InkMute}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="{StaticResource InkMute}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="ProgressCard" Grid.Row="3" Style="{StaticResource GlassCard}" Padding="18,12"
                Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProgressText" FontSize="13" Foreground="{StaticResource Ink}" />
                <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#33FFFFFF"
                        Margin="0,8,0,0" ClipToBounds="True">
                    <Border x:Name="ProgressFill" Background="{StaticResource AccentDeep}" CornerRadius="2"
                            HorizontalAlignment="Left" Width="0" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="下载"
                    MinWidth="150" Height="42" Padding="20,0" Click="StartDownload_Click" />
            <TextBlock x:Name="HintText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
