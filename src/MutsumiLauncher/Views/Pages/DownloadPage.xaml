<UserControl x:Class="MutsumiLauncher.Views.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="18,2,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧来源 ===== -->
        <Border Grid.Column="0" Background="#59FFFFFF" CornerRadius="20"
                BorderBrush="#70FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,16,0">
            <StackPanel>
                <RadioButton Style="{StaticResource SidebarItem}" GroupName="DownloadSource"
                             IsChecked="True" Tag="original" Checked="Source_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/grass.png" Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                        <TextBlock Text="原版资源" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Border Background="#40FFFFFF" CornerRadius="14" Margin="0,10,0,0" Padding="0,4">
                    <StackPanel>
                        <ToggleButton x:Name="CommunityToggle" Style="{StaticResource SectionToggle}"
                                      IsChecked="True" Checked="CommunityToggle_Changed"
                                      Unchecked="CommunityToggle_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                <TextBlock Text="社区资源" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <StackPanel x:Name="CommunityItems" Margin="0,0,0,6">
                            <RadioButton Style="{StaticResource SidebarSubItem}" GroupName="DownloadSource"
                                         Tag="mod" Checked="Source_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="mod" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarSubItem}" GroupName="DownloadSource"
                                         Tag="pack" Checked="Source_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="整合包" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarSubItem}" GroupName="DownloadSource"
                                         Tag="datapack" Checked="Source_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="数据包" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarSubItem}" GroupName="DownloadSource"
                                         Tag="resourcepack" Checked="Source_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="资源包" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarSubItem}" GroupName="DownloadSource"
                                         Tag="shader" Checked="Source_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock Text="光影包" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 右侧：原版资源 ===== -->
        <ScrollViewer x:Name="OriginalPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,4,0">

                <Border Style="{StaticResource GlassCard}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="最新版本" Style="{StaticResource H1}" />
                        <ItemsControl ItemsSource="{Binding Latest}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="34" Height="34"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="17"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Style="{StaticResource Accordion}" Header="{Binding Title}"
                                      Margin="0,0,0,14">
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="46">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                                               Foreground="{StaticResource Ink}" />
                                                    <TextBlock Text="{Binding Caption}" FontSize="11"
                                                               Foreground="{StaticResource InkMute}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 右侧：社区资源搜索 ===== -->
        <Grid x:Name="CommunityPanel" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GlassCard}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="搜索 Mod" Style="{StaticResource H1}" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                        <controls:MtlSearchBox x:Name="SearchNameBox" Grid.Column="1" Margin="0,0,16,0"
                                               Placeholder="输入 Mod 名称" />
                        <TextBlock Text="来源" Style="{StaticResource FieldLabel}" Grid.Column="2" Margin="8,0,0,0" />
                        <ComboBox Grid.Column="3" Style="{StaticResource MtlComboBox}" SelectedIndex="0">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="Modrinth" />
                            <ComboBoxItem Content="CurseForge" />
                        </ComboBox>

                        <TextBlock Text="版本" Style="{StaticResource FieldLabel}" Grid.Row="1" Margin="0,10,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MtlComboBox}"
                                  Margin="0,10,16,0" SelectedIndex="0">
                            <ComboBoxItem Content="全部（也可自行输入）" />
                            <ComboBoxItem Content="1.21.1" />
                            <ComboBoxItem Content="1.20.1" />
                        </ComboBox>
                        <TextBlock Text="类型" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="2"
                                   Margin="8,10,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="3" Style="{StaticResource MtlComboBox}"
                                  Margin="0,10,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="Fabric" />
                            <ComboBoxItem Content="NeoForge" />
                        </ComboBox>

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                    Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="搜索" Width="110"
                                    Click="Search_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Content="重置条件" Width="110"
                                    Margin="10,0,0,0" Click="ResetSearch_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22,14" Margin="0,14,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="10"
                                                Background="{Binding IconBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           Foreground="{StaticResource Ink}" />
                                                <TextBlock Text="{Binding EnglishName}" FontSize="12"
                                                           Foreground="{StaticResource InkMute}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Version}" FontSize="11"
                                                           Foreground="{StaticResource InkMute}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Tags}" FontSize="11"
                                                       Foreground="{StaticResource AccentDeep}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11"
                                                       Foreground="{StaticResource InkMute}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <controls:LoadingOverlay x:Name="SearchLoading" Grid.RowSpan="2" Panel.ZIndex="10"
                                     Label="正在搜索…" />
        </Grid>
    </Grid>
</UserControl>
