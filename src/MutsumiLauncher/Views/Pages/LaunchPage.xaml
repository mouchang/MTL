<UserControl x:Class="MutsumiLauncher.Views.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left"
                    Margin="88,30,0,0" Width="340">

            <!-- 头像 -->
            <Grid Width="104" Height="104" HorizontalAlignment="Left">
                <Border CornerRadius="52" Background="#59FFFFFF" BorderBrush="#8CFFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270"
                                          Opacity="0.14" Color="#FF2E4A38" />
                    </Border.Effect>
                </Border>
                <Image Source="/Assets/avatar.png" Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>

            <!-- 正版 / 用户名 -->
            <Border Background="#8CFFFFFF" CornerRadius="14" Padding="10,6,12,6"
                    Margin="0,20,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource Accent}" CornerRadius="6" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="正版" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="the_box_mc" FontSize="17" Foreground="{StaticResource Ink}"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkIconButton}" Content="&#xE8C8;"
                            Margin="6,0,0,0" Click="CopyName_Click" ToolTip="复制用户名" />
                </StackPanel>
            </Border>

            <!-- 版本 -->
            <Border Background="#73FFFFFF" CornerRadius="22" Height="44" Padding="18,0"
                    Margin="0,12,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="1.21.1  fabric" FontSize="15" Foreground="{StaticResource InkSoft}" />
                    <Button Style="{StaticResource LinkIconButton}" Content="&#xE713;"
                            Margin="10,0,0,0" ToolTip="版本设置" Click="VersionSettings_Click" />
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Button x:Name="LaunchButton" Content="启动游戏" Style="{StaticResource LaunchButton}"
                    Margin="0,20,0,0" Click="Launch_Click" />
        </StackPanel>
    </Grid>
</UserControl>
