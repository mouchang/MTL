<UserControl x:Class="MutsumiLauncher.Views.Pages.ModrinthDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource GhostButton}" Padding="8,4" Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                    <TextBlock Text="返回" FontSize="13" Foreground="{StaticResource InkSoft}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="BreadcrumbText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="10,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="64" Height="64" VerticalAlignment="Top">
                    <Border CornerRadius="14" Background="#E6F2E8">
                        <TextBlock x:Name="InitialText" FontSize="20" Foreground="{StaticResource AccentDeep}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="IconBorder" CornerRadius="14" ClipToBounds="True"
                            Visibility="Collapsed">
                        <Image x:Name="IconImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" FontSize="20" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="AuthorText" FontSize="12" Foreground="{StaticResource InkMute}"
                                   Margin="10,0,0,2" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="DescriptionText" FontSize="13" Foreground="{StaticResource InkSoft}"
                               Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="44"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" FontSize="11" Foreground="{StaticResource InkMute}"
                               Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="转到 Modrinth"
                                Height="30" Padding="14,0" Click="OpenModrinth_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="复制名称"
                                Height="30" Padding="14,0" Margin="8,0,0,0" Click="CopyName_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,14,0,0">
                    <StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Height="96">
                            <Grid x:Name="TabPanel" Height="80" HorizontalAlignment="Left" />
                        </ScrollViewer>
                        <TextBlock x:Name="VersionSourceText" Style="{StaticResource Caption}"
                                   Margin="2,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}" Padding="22,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ListHeader" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="FileList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Padding="10,8"
                                            Margin="0,2,0,0" HorizontalContentAlignment="Stretch"
                                            Tag="{Binding}" Click="InstallFile_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8"
                                                    Background="{Binding LoaderBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding LoaderInitial}" Foreground="White"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="14"
                                                           Foreground="{StaticResource Ink}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{StaticResource InkMute}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="安装" FontSize="12"
                                                       Foreground="{StaticResource AccentDeep}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay x:Name="Loading" Grid.RowSpan="3" Panel.ZIndex="10"
                                 Label="正在加载…" />
    </Grid>
</UserControl>
