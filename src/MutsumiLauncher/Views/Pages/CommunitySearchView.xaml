<UserControl x:Class="MutsumiLauncher.Views.Pages.CommunitySearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Padding="22,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="搜索 Mod" Style="{StaticResource H1}"
                           Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <controls:MtlSearchBox x:Name="SearchNameBox" Grid.Column="1" Grid.ColumnSpan="3"
                                           Placeholder="输入名称" />
                    <TextBlock Text="来源" Style="{StaticResource FieldLabel}" Grid.Column="4" Margin="8,0,0,0" />
                    <ComboBox x:Name="SourceCombo" Grid.Column="5" Style="{StaticResource MtlComboBox}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="聚合" Tag="all" />
                        <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                        <ComboBoxItem Content="CurseForge" Tag="curseforge" />
                    </ComboBox>

                    <TextBlock Text="版本" Style="{StaticResource FieldLabel}" Grid.Row="1" Margin="0,10,0,0" />
                    <ComboBox x:Name="VersionCombo" Grid.Row="1" Grid.Column="1"
                              Style="{StaticResource MtlComboBox}" Margin="0,10,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="全部（也可自行输入）" Tag="" />
                        <ComboBoxItem Content="26.2" Tag="26.2" />
                        <ComboBoxItem Content="1.21.1" Tag="1.21.1" />
                        <ComboBoxItem Content="1.20.1" Tag="1.20.1" />
                        <ComboBoxItem Content="1.16.5" Tag="1.16.5" />
                    </ComboBox>
                    <ComboBox x:Name="LoaderCombo" Grid.Row="1" Grid.Column="3"
                              Style="{StaticResource MtlComboBox}" Margin="0,10,0,0"
                              SelectedIndex="0" Visibility="Collapsed">
                        <ComboBoxItem Content="任意 Mod 加载器" Tag="" />
                        <ComboBoxItem Content="Fabric" Tag="fabric" />
                        <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                        <ComboBoxItem Content="Forge" Tag="forge" />
                        <ComboBoxItem Content="Quilt" Tag="quilt" />
                    </ComboBox>
                    <TextBlock Text="类型" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="4"
                               Margin="8,10,0,0" />
                    <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="5" Style="{StaticResource MtlComboBox}"
                              Margin="0,10,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="全部" Tag="" />
                        <ComboBoxItem Content="优化" Tag="optimization" />
                        <ComboBoxItem Content="冒险" Tag="adventure" />
                        <ComboBoxItem Content="科技" Tag="technology" />
                        <ComboBoxItem Content="魔法" Tag="magic" />
                        <ComboBoxItem Content="装饰" Tag="decoration" />
                        <ComboBoxItem Content="实用" Tag="utility" />
                        <ComboBoxItem Content="世界生成" Tag="worldgen" />
                    </ComboBox>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal"
                                Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="搜索" Width="110"
                                Click="Search_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="重置条件" Width="110"
                                Margin="10,0,0,0" Click="ResetSearch_Click" />
                        <Button x:Name="InstallPackButton" Style="{StaticResource SecondaryButton}"
                                Content="安装已有整合包" Width="150" Margin="10,0,0,0"
                                Visibility="Collapsed" Click="InstallPack_Click" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5"
                               Style="{StaticResource Caption}" Margin="0,10,0,0" Text="" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22,14" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF"
                                    Background="Transparent" PreviewMouseLeftButtonUp="OpenDetail_Click"
                                    Tag="{Binding}" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="42" Height="42" VerticalAlignment="Top">
                                        <Border CornerRadius="10" Background="#E6F2E8">
                                            <TextBlock Text="{Binding Initial}" FontSize="14"
                                                       Foreground="{StaticResource AccentDeep}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="10" ClipToBounds="True">
                                            <Image Source="{Binding IconPath}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="15"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding Author}" FontSize="12"
                                                       Foreground="{StaticResource InkMute}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                                           Foreground="{Binding SourceBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11"
                                                   Foreground="{StaticResource InkMute}" Margin="0,3,0,0" />
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="PageBar" Margin="0,12,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="PageInfo" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <WrapPanel x:Name="PagePanel" />
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <controls:LoadingOverlay x:Name="Loading" Grid.RowSpan="2" Panel.ZIndex="10"
                                 Label="正在搜索…" />
    </Grid>
</UserControl>
