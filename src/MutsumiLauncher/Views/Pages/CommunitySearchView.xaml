<UserControl x:Class="MutsumiLauncher.Views.Pages.CommunitySearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Padding="22,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="搜索 Mod" Style="{StaticResource H1}"
                           Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <controls:MtlSearchBox x:Name="SearchNameBox" Grid.Column="1" Grid.ColumnSpan="3"
                                           Placeholder="输入名称" PreviewKeyDown="Filter_KeyDown" />
                    <TextBlock Text="来源" Style="{StaticResource FieldLabel}" Grid.Column="4" Margin="8,0,0,0" />
                    <ComboBox x:Name="SourceCombo" Grid.Column="5" Style="{StaticResource MtlComboBox}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="聚合" Tag="all" />
                        <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                        <ComboBoxItem Content="CurseForge" Tag="curseforge" />
                    </ComboBox>

                    <TextBlock Text="版本" Style="{StaticResource FieldLabel}" Grid.Row="1" Margin="0,10,0,0" />
                    <ComboBox x:Name="VersionCombo" Grid.Row="1" Grid.Column="1"
                              Style="{StaticResource MtlComboBox}" Margin="0,10,0,0" SelectedIndex="0"
                              IsEditable="True" PreviewKeyDown="Filter_KeyDown">
                        <ComboBoxItem Content="全部（也可自行输入）" Tag="" />
                        <ComboBoxItem Content="26.2" Tag="26.2" />
                        <ComboBoxItem Content="1.21.1" Tag="1.21.1" />
                        <ComboBoxItem Content="1.20.1" Tag="1.20.1" />
                        <ComboBoxItem Content="1.16.5" Tag="1.16.5" />
                    </ComboBox>
                    <ComboBox x:Name="LoaderCombo" Grid.Row="1" Grid.Column="3"
                              Style="{StaticResource MtlComboBox}" Margin="0,10,0,0"
                              SelectedIndex="0" Visibility="Collapsed">
                        <ComboBoxItem Content="任意 Mod 加载器" Tag="" />
                        <ComboBoxItem Content="Fabric" Tag="fabric" />
                        <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                        <ComboBoxItem Content="Forge" Tag="forge" />
                        <ComboBoxItem Content="Quilt" Tag="quilt" />
                    </ComboBox>
                    <TextBlock Text="类型" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="4"
                               Margin="8,10,0,0" />
                    <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="5" Style="{StaticResource MtlComboBox}"
                              Margin="0,10,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="全部" Tag="" />
                        <!-- 其余选项在 LoadCategoriesAsync 里按平台标签填充 -->
                    </ComboBox>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal"
                                Margin="0,16,0,0">
                        <TextBlock Text="排序" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="SortCombo" Style="{StaticResource MtlComboBox}" Width="120"
                                  SelectedIndex="0" Margin="0,0,16,0">
                            <ComboBoxItem Content="下载量" Tag="downloads" />
                            <ComboBoxItem Content="更新时间" Tag="updated" />
                            <ComboBoxItem Content="相关度" Tag="relevance" />
                        </ComboBox>
                        <Button Style="{StaticResource PrimaryButton}" Content="搜索" Width="110"
                                Click="Search_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="重置条件" Width="110"
                                Margin="10,0,0,0" Click="ResetSearch_Click" />
                        <Button x:Name="InstallPackButton" Style="{StaticResource SecondaryButton}"
                                Content="安装已有整合包" Width="150" Margin="10,0,0,0"
                                Visibility="Collapsed" Click="InstallPack_Click" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5"
                               Style="{StaticResource Caption}" Margin="0,10,0,0" Text="" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22,14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 虚拟化：只创建视口内的卡片，前后各留 1~2 屏 -->
                <ItemsControl x:Name="ResultsList" Grid.Row="0" Style="{StaticResource VirtualList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}"
                                    Background="Transparent" MouseLeftButtonUp="OpenDetail_Click"
                                    Tag="{Binding}" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="42" Height="42" VerticalAlignment="Top">
                                        <Border CornerRadius="10" Background="{DynamicResource AccentTint}">
                                            <TextBlock Text="{Binding Initial}" FontSize="14"
                                                       Foreground="{DynamicResource AccentDeep}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="10" ClipToBounds="True">
                                            <Image Source="{Binding IconPath, Converter={StaticResource IconSource}}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryTitle}" FontSize="15"
                                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Author}" FontSize="12"
                                                       Foreground="{DynamicResource InkMute}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <!-- 来源：Modrinth -->
                                            <Border Tag="Modrinth" Cursor="Hand" CornerRadius="8"
                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource ChipBg}" MouseLeftButtonUp="SourceChip_Click"
                                                    Visibility="{Binding HasModrinth, Converter={StaticResource BoolToVis}}">

                                                <Grid>
                                                    <Border CornerRadius="8" Background="{DynamicResource Accent}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ModrinthSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Grid Margin="8,1">
                                                        <TextBlock Text="Modrinth" FontSize="10"
                                                                   Foreground="{DynamicResource SourceGreen}" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ModrinthSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="Modrinth" FontSize="10" Foreground="White" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ModrinthSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <!-- 来源：CurseForge -->
                                            <Border Tag="CurseForge" Cursor="Hand" CornerRadius="8"
                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource ChipBg}" MouseLeftButtonUp="SourceChip_Click"
                                                    Visibility="{Binding HasCurseForge, Converter={StaticResource BoolToVis}}">

                                                <Grid>
                                                    <!-- 选中底色用 CurseForge 自己的橙色，和 Modrinth 的绿色区分开 -->
                                                    <Border CornerRadius="8" Background="{DynamicResource SourceOrange}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurseForgeSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Grid Margin="8,1">
                                                        <TextBlock Text="CurseForge" FontSize="10"
                                                                   Foreground="{DynamicResource SourceOrange}" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurseForgeSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="CurseForge" FontSize="10" Foreground="White" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurseForgeSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModrinthSelected}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CurseForgeSelected}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="{Binding SecondaryTitle}" FontSize="12"
                                                       Foreground="{DynamicResource InkSoft}" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding SecondaryTitleVisibility}" />
                                            <TextBlock Text="{Binding TagsText}" FontSize="11"
                                                       Foreground="{DynamicResource AccentDeep}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding TagsVisibility}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11"
                                                       Foreground="{DynamicResource InkMute}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="PageBar" Grid.Row="1" Margin="0,12,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="PageInfo" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <WrapPanel x:Name="PagePanel" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:LoadingOverlay x:Name="Loading" Grid.RowSpan="2" Panel.ZIndex="10"
                                 Label="正在搜索…" />
    </Grid>
</UserControl>