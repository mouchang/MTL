<UserControl x:Class="MutsumiLauncher.Views.Pages.CommunitySearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCard}" Padding="22,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="搜索 Mod" Style="{StaticResource H1}"
                           Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <controls:MtlSearchBox x:Name="SearchNameBox" Grid.Column="1" Margin="0,0,16,0"
                                           Placeholder="输入名称" />
                    <TextBlock Text="来源" Style="{StaticResource FieldLabel}" Grid.Column="2" Margin="8,0,0,0" />
                    <ComboBox Grid.Column="3" Style="{StaticResource MtlComboBox}" SelectedIndex="0">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="Modrinth" />
                        <ComboBoxItem Content="CurseForge" />
                    </ComboBox>

                    <TextBlock Text="版本" Style="{StaticResource FieldLabel}" Grid.Row="1" Margin="0,10,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MtlComboBox}"
                              Margin="0,10,16,0" SelectedIndex="0">
                        <ComboBoxItem Content="全部（也可自行输入）" />
                        <ComboBoxItem Content="1.21.1" />
                        <ComboBoxItem Content="1.20.1" />
                    </ComboBox>
                    <TextBlock Text="类型" Style="{StaticResource FieldLabel}" Grid.Row="1" Grid.Column="2"
                               Margin="8,10,0,0" />
                    <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="3" Style="{StaticResource MtlComboBox}"
                              Margin="0,10,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="全部" />
                    </ComboBox>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="搜索" Width="110"
                                Click="Search_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="重置条件" Width="110"
                                Margin="10,0,0,0" Click="ResetSearch_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22,14" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10"
                                            Background="{Binding IconBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" Foreground="White"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding EnglishName}" FontSize="12"
                                                       Foreground="{StaticResource InkMute}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                       Foreground="{StaticResource InkMute}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Tags}" FontSize="11"
                                                   Foreground="{StaticResource AccentDeep}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11"
                                                   Foreground="{StaticResource InkMute}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <controls:LoadingOverlay x:Name="Loading" Grid.RowSpan="2" Panel.ZIndex="10"
                                 Label="正在搜索…" />
    </Grid>
</UserControl>
