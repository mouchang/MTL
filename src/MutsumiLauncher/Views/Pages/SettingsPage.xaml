<UserControl x:Class="MutsumiLauncher.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="760" HorizontalAlignment="Left" Margin="24,4,24,24">
            <TextBlock Text="设置" Style="{StaticResource H1}" Margin="4,0,0,10" />

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Java 运行时" Style="{StaticResource H2}" />
                        <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}"
                                Content="重新检测" Height="30" Padding="14,0"
                                HorizontalAlignment="Right" Click="RefreshJava_Click" />
                    </Grid>

                    <TextBlock x:Name="JavaStatus" Style="{StaticResource Caption}"
                               Margin="0,6,0,0" Text="正在检测本机 Java…" TextWrapping="Wrap" />

                    <ItemsControl x:Name="JavaList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,9" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayVersion}" FontSize="14"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding Source}" FontSize="11"
                                                       Foreground="{StaticResource InkMute}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11"
                                                   Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="下载源" Style="{StaticResource H2}" />
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource InkMute}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="SourceSummary" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="正在读取…" />
                    <Button Style="{StaticResource SecondaryButton}" Content="更改下载源"
                            Height="32" Padding="16,0" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Click="OpenSource_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="内存分配" Style="{StaticResource H2}" />
                    <TextBlock x:Name="MemoryHint" Style="{StaticResource Caption}" Margin="0,4,0,10"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MemoryAutoRadio" Style="{StaticResource SegmentItem}"
                                     GroupName="MemoryMode" Content="自动配置"
                                     Checked="MemoryMode_Checked" />
                        <RadioButton x:Name="MemoryManualRadio" Style="{StaticResource SegmentItem}"
                                     GroupName="MemoryMode" Content="自定义"
                                     Margin="11,0,0,0" Checked="MemoryMode_Checked" />
                        <TextBlock x:Name="MemoryValueText" FontSize="14" Margin="16,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentDeep}" />
                    </StackPanel>

                    <Slider x:Name="MemorySlider" Style="{StaticResource MtlSlider}"
                            Minimum="512" Maximum="65536" SmallChange="512"
                            LargeChange="1024" TickFrequency="512" IsSnapToTickEnabled="True"
                            Margin="0,12,0,0" ValueChanged="MemorySlider_ValueChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="缓存" Style="{StaticResource H2}" />
                        <Button x:Name="ClearCacheButton" Style="{StaticResource SecondaryButton}"
                                Content="清理缓存" Height="30" Padding="14,0"
                                HorizontalAlignment="Right" Click="ClearCache_Click" />
                    </Grid>
                    <TextBlock x:Name="CacheSizeText" Style="{StaticResource Caption}"
                               Margin="0,6,0,0" Text="正在统计…" />
                    <TextBlock x:Name="CachePathText" FontSize="11"
                               Foreground="{StaticResource InkSoft}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="关于" Style="{StaticResource H2}" />
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}"
                                Content="检查更新" Height="30" Padding="14,0"
                                HorizontalAlignment="Right" Click="CheckUpdate_Click" />
                    </Grid>
                    <TextBlock x:Name="VersionText" Text="Mutsumi Launcher" Style="{StaticResource Body}"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="UpdateStatus" Text="WPF · .NET 10 · 开源" Style="{StaticResource Caption}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <!-- 下载源子界面：从右侧滑入 -->
    <ContentControl x:Name="SourceHost" Visibility="Collapsed" Opacity="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    Panel.ZIndex="10">
        <ContentControl.RenderTransform>
            <TranslateTransform x:Name="SourceSlide" X="0" />
        </ContentControl.RenderTransform>
    </ContentControl>
    </Grid>
</UserControl>
