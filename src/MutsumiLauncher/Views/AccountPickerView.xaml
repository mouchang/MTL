<UserControl x:Class="MutsumiLauncher.Views.AccountPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid x:Name="Root" Background="#33000000" Opacity="0" MouseDown="Backdrop_MouseDown">
        <Border x:Name="Card" VerticalAlignment="Bottom" Margin="28,0,28,28" CornerRadius="22"
                Background="#F9FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.22"
                                  Color="#FF2E4A38" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="460" />
            </Border.RenderTransform>

            <StackPanel>
                <Grid>
                    <TextBlock Text="账号" Style="{StaticResource H1}" />
                    <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                            Content="&#xE711;" Click="Close_Click" ToolTip="关闭" />
                </Grid>

                <TextBlock Text="点击账号即可切换。支持离线账号与微软正版账号。"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" />

                <ScrollViewer MaxHeight="260" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Button Style="{StaticResource GhostButton}" Padding="12,8"
                                            HorizontalContentAlignment="Stretch" Tag="{Binding}"
                                            Click="Account_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="{Binding AvatarBrush}">
                                                <TextBlock Text="{Binding Initial}" Foreground="White"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           Foreground="{StaticResource Ink}" />
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                                           Foreground="{StaticResource InkMute}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="&#xE73E;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="14" Foreground="{StaticResource AccentDeep}"
                                                       VerticalAlignment="Center" Margin="0,0,46,0"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource LinkIconButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,14,0" Tag="{Binding}" Click="Delete_Click"
                                            ToolTip="删除账号">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Foreground="{StaticResource InkMute}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewNameBox" Style="{StaticResource SheetTextBox}" Height="38" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="添加"
                            Width="88" Height="38" Margin="10,0,0,0" Click="Add_Click" />
                </Grid>

                <TextBlock x:Name="HintText" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="输入离线用户名（3–16 位，字母、数字或下划线），回车或点添加。" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="有正版账号？用微软账号登录。" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="正版登录" Height="34" Padding="16,0"
                            Click="MicrosoftLogin_Click" />
                </Grid>


            </StackPanel>
        </Border>
    </Grid>
</UserControl>
