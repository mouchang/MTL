<UserControl x:Class="MutsumiLauncher.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Background="#33000000" MouseDown="Backdrop_MouseDown">
        <Border Margin="40,40,40,40" CornerRadius="22" Background="#FAFFFFFF"
                BorderBrush="#88FFFFFF" BorderThickness="1" Padding="22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.22"
                                  Color="#FF2E4A38" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="启动日志" Style="{StaticResource H1}" />
                    <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                            Content="&#xE711;" Click="Close_Click" ToolTip="关闭" />
                </Grid>

                <TextBlock x:Name="PathText" Grid.Row="1" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" TextTrimming="CharacterEllipsis" />

                <Border Grid.Row="2" Background="#F2F7FBF4" CornerRadius="12" Padding="12">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas, Courier New"
                                 FontSize="12" Foreground="{StaticResource Ink}"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="刷新" Width="100"
                            Click="Refresh_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="打开日志文件夹" Width="150"
                            Margin="10,0,0,0" Click="OpenFolder_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="复制全部" Width="120"
                            Margin="10,0,0,0" Click="Copy_Click" />
                    <CheckBox x:Name="AutoRefreshCheck" Style="{StaticResource MtlCheckBox}"
                              Content="自动刷新" IsChecked="True" Margin="18,0,0,0"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
