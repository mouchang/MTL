<Window x:Class="MutsumiLauncher.Views.InstallTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装位置" Width="560" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="24">
        <Border Background="{DynamicResource SurfaceFloat}" CornerRadius="18"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.18" />
            </Border.Effect>

            <Grid Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText" Text="安装到" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" />

                <TextBlock x:Name="HintText" Grid.Row="1" Style="{StaticResource Caption}"
                           Margin="0,6,0,14" TextWrapping="Wrap" />

                <Border Grid.Row="2" Background="{DynamicResource PaneBg}" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="目标文件夹" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="FolderText" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="文件名" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBlock x:Name="FileText" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource InkMute}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" x:Name="NoteText" Style="{StaticResource Caption}"
                           Margin="2,12,0,0" TextWrapping="Wrap" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="换个位置…" Padding="14,7"
                            Margin="0,0,8,0" Click="Browse_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="取消" Width="90"
                            Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="安装" Width="100"
                            Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
