<UserControl x:Class="MutsumiLauncher.Views.VersionSettings.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Border Style="{StaticResource GlassCard}" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/grass.png" Width="44" Height="44"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="猫饼镇 beta 1.21.1" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock Text="正式版 1.21.1 · Fabric 0.19.5" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="个性化" Style="{StaticResource H2}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图标" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MtlComboBox}" SelectedIndex="0">
                            <ComboBoxItem Content="自动" />
                            <ComboBoxItem Content="草方块" />
                            <ComboBoxItem Content="泥土" />
                            <ComboBoxItem Content="工作台" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分类" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MtlComboBox}" SelectedIndex="0">
                            <ComboBoxItem Content="自动" />
                            <ComboBoxItem Content="生存" />
                            <ComboBoxItem Content="创造" />
                            <ComboBoxItem Content="整合包" />
                        </ComboBox>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="修改版本名" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="修改版本描述" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="加入收藏夹" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="快捷方式" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="版本文件夹" Width="150" Margin="0,0,10,10" />
                        <Button Style="{StaticResource SecondaryButton}" Content="存档文件夹" Width="150" Margin="0,0,10,10" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Mod 文件夹" Width="150" Margin="0,0,10,10" />
                        <Button Style="{StaticResource SecondaryButton}" Content="截图文件夹" Width="150" Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="高级管理" Style="{StaticResource H2}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="导出启动脚本"
                                Width="150" Margin="0,0,10,10" />
                        <Button Style="{StaticResource SecondaryButton}" Content="补全文件"
                                Width="150" Margin="0,0,10,10" />
                        <Button Style="{StaticResource DangerButton}" Content="删除版本"
                                Width="150" Margin="0,0,10,10" Click="DeleteVersion_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
