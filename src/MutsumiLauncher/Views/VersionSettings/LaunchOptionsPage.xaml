<UserControl x:Class="MutsumiLauncher.Views.VersionSettings.LaunchOptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Border Background="{DynamicResource AccentTintSoft}" CornerRadius="12" Padding="16,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AccentDeep}" CornerRadius="2" Margin="0,0,12,0" />
                    <TextBlock x:Name="InstanceHintText" Grid.Column="1"
                               Text="这些设置只对该实例生效，不影响其他版本。"
                               FontSize="13" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="启动选项" Style="{StaticResource H2}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="版本隔离" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="IsolationCombo" Grid.Column="1"
                                  Style="{StaticResource MtlComboBox}" SelectedIndex="2"
                                  SelectionChanged="IsolationCombo_SelectionChanged">
                            <ComboBoxItem Content="开启" />
                            <ComboBoxItem Content="关闭" />
                            <ComboBoxItem Content="跟随全局设置" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="开启后存档、mods、配置都放在版本自己的目录里。"
                               Style="{StaticResource Caption}" Margin="110,4,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="JavaCombo" Grid.Column="1" Style="{StaticResource MtlComboBox}"
                                  SelectedIndex="0" SelectionChanged="JavaCombo_SelectionChanged" />
                    </Grid>

                    <Border Background="{DynamicResource InfoTint}" CornerRadius="10" Padding="14,10" Margin="110,10,0,0">
                        <TextBlock x:Name="JavaInfoText" FontSize="12" Foreground="{DynamicResource InfoInk}"
                                   TextWrapping="Wrap" Text="正在检测本机 Java…" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="内存分配" Style="{StaticResource H2}" />

                    <StackPanel Margin="6,14,0,0">
                        <RadioButton x:Name="MemoryFollowRadio" Style="{StaticResource MtlRadio}"
                                     Content="跟随全局设置" Margin="0,0,0,12" Checked="MemoryRadio_Checked" />
                        <RadioButton x:Name="MemoryAutoRadio" Style="{StaticResource MtlRadio}"
                                     Content="自动配置（不指定 -Xmx）" Margin="0,0,0,12"
                                     Checked="MemoryRadio_Checked" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="MemoryCustomRadio" Style="{StaticResource MtlRadio}"
                                         Content="自定义" VerticalAlignment="Center"
                                         Checked="MemoryRadio_Checked" />
                            <Slider x:Name="MemorySlider" Grid.Column="1" Style="{StaticResource MtlSlider}"
                                    Minimum="512" Maximum="32768" Value="8192" Margin="16,0,0,0"
                                    VerticalAlignment="Center" ValueChanged="MemorySlider_ValueChanged" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="MemoryAllocText" FontSize="13" Foreground="{DynamicResource Ink}"
                               Margin="6,14,0,0" Text="8.0 GB" />

                    <Button Style="{StaticResource SecondaryButton}" Content="恢复默认（跟随全局）"
                            HorizontalAlignment="Left" Margin="6,16,0,0" Padding="16,0" Height="34"
                            Click="Reset_Click" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>