<UserControl x:Class="MutsumiLauncher.Views.VersionSettings.ModManagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:MtlSearchBox x:Name="SearchBox" Placeholder="搜索 Mod 文件名"
                               TextChanged="SearchBox_TextChanged" />

        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="InstallNewModButton" Style="{StaticResource PrimaryButton}" Content="安装新 Mod"
                    Width="130" Margin="0,0,10,0" Click="InstallNewMod_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="打开文件夹" Width="130"
                    Margin="0,0,10,0" Click="OpenFolder_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="从文件安装" Width="130"
                    Margin="0,0,10,0" Click="InstallFromFile_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="检查更新" Width="120"
                    Margin="0,0,10,0" Click="CheckUpdates_Click" />
            <Button x:Name="UpdateAllButton" Style="{StaticResource SecondaryButton}" Content="全部更新"
                    Width="110" Margin="0,0,10,0" Click="UpdateAll_Click" />
<!-- 「可更新」按钮在筛选行里（和全部/启用/禁用同款） -->
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="18,12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="NoLoaderHint" Background="{DynamicResource DangerWash}" CornerRadius="10" Padding="14,12"
                        Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock Text="此版本不支持安装 Mod（原版没有加载器）"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DangerInk}"
                               TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                    <RadioButton x:Name="AllFilter" Style="{StaticResource SegmentItem}" GroupName="ModFilter"
                                 Tag="all" IsChecked="True" Checked="Filter_Checked" Margin="0,0,4,0">
                        <TextBlock x:Name="AllFilterText" Text="全部 (0)" />
                    </RadioButton>
                    <RadioButton x:Name="EnabledFilter" Style="{StaticResource SegmentItem}"
                                 GroupName="ModFilter" Tag="enabled" Checked="Filter_Checked" Margin="4,0,0,0">
                        <TextBlock x:Name="EnabledFilterText" Text="启用 (0)" />
                    </RadioButton>
                    <RadioButton x:Name="DisabledFilter" Style="{StaticResource SegmentItem}"
                                 GroupName="ModFilter" Tag="disabled" Checked="Filter_Checked" Margin="4,0,0,0">
                        <TextBlock x:Name="DisabledFilterText" Text="禁用 (0)" />
                    </RadioButton>
                    <RadioButton x:Name="UpdatesFilter" Style="{StaticResource SegmentItem}"
                                 GroupName="ModFilter" Tag="updates" Checked="Filter_Checked"
                                 Margin="4,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="UpdatesFilterText" Text="可更新 (0)" />
                    </RadioButton>
                </StackPanel>


                <!-- 虚拟化：Mod 多的时候只创建可见行 -->
                <ItemsControl x:Name="ModList" Grid.Row="1" Style="{StaticResource VirtualList}"
                              ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource MtlCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10"
                                                Background="{Binding IconBrush}" VerticalAlignment="Top"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource InkMute}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding InitialVisibility}" />
                                                <Image Source="{Binding IconPath, Converter={StaticResource IconSource}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding IconVisibility}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15"
                                                       Foreground="{DynamicResource Ink}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                                           Foreground="{DynamicResource AccentDeep}" />
                                                <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                           Foreground="{DynamicResource InkMute}"
                                                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdateText}" FontSize="11"
                                                       Foreground="{DynamicResource AccentDeep}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Visibility="{Binding UpdateVisibility}" />
                                            <Button Style="{StaticResource RowActionButton}" Content="更新"
                                                    Visibility="{Binding UpdateVisibility}"
                                                    Tag="{Binding}" Click="UpdateMod_Click" />
                                            <Button Style="{StaticResource RowActionButton}"
                                                    Content="{Binding ToggleText}"
                                                    Tag="{Binding}" Click="ToggleMod_Click" />
                                            <Button Style="{StaticResource RowActionButton}" Content="位置"
                                                    ToolTip="在资源管理器里定位这个文件"
                                                    Tag="{Binding}" Click="RevealMod_Click" />
                                            <Button Style="{StaticResource RowActionButton}" Content="信息"
                                                    ToolTip="按名称搜索 MC百科"
                                                    Tag="{Binding}" Click="InfoMod_Click" />
                                            <Button Style="{StaticResource RowDangerButton}" Content="删除"
                                                    Tag="{Binding}" Click="DeleteMod_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="这个实例还没有安装 Mod。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 更新进度：更新 Mod 时显示，比盯下载面板直观 -->
        <Border x:Name="UpdateProgressBar" Grid.Row="3" Style="{StaticResource GlassCard}"
                Padding="18,12" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="UpdateProgressText" FontSize="12"
                           Foreground="{DynamicResource InkSoft}" />
                <ProgressBar x:Name="UpdateProgressValue" Style="{StaticResource RoundedProgress}"
                             Margin="0,8,0,0" Minimum="0" Maximum="100" />
            </StackPanel>
        </Border>

        <!-- 多选批量操作栏：有选中项时才出现 -->
        <Border x:Name="SelectionBar" Grid.Row="4" Style="{StaticResource GlassCard}"
                Padding="18,10" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource InkSoft}" Text="已选择 0 个文件" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SelectEnableButton" Style="{StaticResource GhostButton}" Content="启用"
                            Height="30" Padding="12,0" Margin="0,0,8,0" Click="BatchEnable_Click" />
                    <Button x:Name="SelectDisableButton" Style="{StaticResource GhostButton}" Content="禁用"
                            Height="30" Padding="12,0" Margin="0,0,8,0" Click="BatchDisable_Click" />
                    <Button x:Name="SelectUpdateButton" Style="{StaticResource GhostButton}" Content="更新"
                            Height="30" Padding="12,0" Margin="0,0,8,0" Click="BatchUpdate_Click" />
                    <Button x:Name="SelectDeleteButton" Style="{StaticResource GhostButton}" Content="删除"
                            Height="30" Padding="12,0" Margin="0,0,8,0" Click="BatchDelete_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="取消选择"
                            Height="30" Padding="12,0" Click="ClearSelection_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 检查更新时盖住整页：也挡住上面的按钮，避免重复触发 -->
        <Border x:Name="CheckingOverlay" Grid.Row="0" Grid.RowSpan="5"
                Background="{DynamicResource GlassStrong}" Visibility="Collapsed">
            <Border Background="{DynamicResource SurfaceSolid}" CornerRadius="16"
                    Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                      Opacity="0.15" Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
                <StackPanel Width="220">
                    <Grid Height="6" ClipToBounds="True">
                        <Border Background="{DynamicResource Divider}" CornerRadius="3" />
                        <Border x:Name="BusyBar" Width="64" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentDeep}" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BusyTranslate" X="-64" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Text="检查更新中，请稍后…" Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource InkSoft}" FontSize="13" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>