<UserControl x:Class="MutsumiLauncher.Views.VersionSettings.ModManagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MutsumiLauncher.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:MtlSearchBox x:Name="SearchBox" Placeholder="搜索 Mod 文件名"
                               TextChanged="SearchBox_TextChanged" />

        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="InstallNewModButton" Style="{StaticResource PrimaryButton}" Content="安装新 Mod"
                    Width="130" Margin="0,0,10,0" Click="InstallNewMod_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="打开文件夹" Width="130"
                    Margin="0,0,10,0" Click="OpenFolder_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="从文件安装" Width="130"
                    Margin="0,0,10,0" Click="InstallFromFile_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="刷新" Width="110"
                    Margin="0,0,10,0" Click="Refresh_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="检查更新" Width="120"
                    Click="CheckUpdates_Click" />
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="18,12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="NoLoaderHint" Background="#FFF4E5E5" CornerRadius="10" Padding="14,12"
                        Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock Text="此版本不支持安装 Mod（原版没有加载器）"
                               FontSize="15" FontWeight="SemiBold" Foreground="#FFB03A2E"
                               TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="ModFilter" Tag="all"
                                 IsChecked="True" Checked="Filter_Checked" Margin="0,0,4,0">
                        <TextBlock x:Name="AllFilterText" Text="全部 (0)" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="ModFilter" Tag="enabled"
                                 Checked="Filter_Checked" Margin="4,0,0,0">
                        <TextBlock x:Name="EnabledFilterText" Text="启用 (0)" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="ModFilter" Tag="disabled"
                                 Checked="Filter_Checked" Margin="4,0,0,0">
                        <TextBlock x:Name="DisabledFilterText" Text="禁用 (0)" />
                    </RadioButton>
                </StackPanel>

                <ScrollViewer x:Name="ModScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42" Height="42" CornerRadius="10"
                                                Background="{Binding IconBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15"
                                                       Foreground="{StaticResource Ink}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                                           Foreground="{StaticResource AccentDeep}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                           Foreground="{StaticResource InkMute}"
                                                           Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdateText}" FontSize="11"
                                                       Foreground="{StaticResource AccentDeep}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Visibility="{Binding UpdateVisibility}" />
                                            <Button Style="{StaticResource GhostButton}" Content="更新"
                                                    Height="30" Padding="12,0" Margin="0,0,8,0"
                                                    Visibility="{Binding UpdateVisibility}"
                                                    Tag="{Binding}" Click="UpdateMod_Click" />
                                            <Button Style="{StaticResource GhostButton}" Content="{Binding ToggleText}"
                                                    Height="30" Padding="12,0" Margin="0,0,8,0"
                                                    Tag="{Binding}" Click="ToggleMod_Click" />
                                            <Button Style="{StaticResource GhostButton}" Content="删除"
                                                    Height="30" Padding="12,0"
                                                    Tag="{Binding}" Click="DeleteMod_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="这个实例还没有安装 Mod。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
