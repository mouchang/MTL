<UserControl x:Class="MutsumiLauncher.Views.VersionSettings.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Border Style="{StaticResource GlassCard}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="导出实例" Style="{StaticResource H2}" />
                    <TextBlock x:Name="InstanceHint" Style="{StaticResource Caption}" Margin="0,4,0,14"
                               Text="把实例打包成整合包，方便分享或备份。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource MtlTextBox}" />
                        <TextBlock Grid.Column="2" Text="版本号" Style="{StaticResource FieldLabel}"
                                   Margin="18,0,0,0" />
                        <TextBox x:Name="VersionBox" Grid.Column="3" Style="{StaticResource MtlTextBox}"
                                 Text="1.0.0" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="导出内容" Style="{StaticResource H2}" />

                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox x:Name="ModsCheck" Style="{StaticResource MtlCheckBox}" IsChecked="True"
                                  Content="Mods" Margin="0,0,24,12" />
                        <CheckBox x:Name="ConfigCheck" Style="{StaticResource MtlCheckBox}" IsChecked="True"
                                  Content="配置 (config)" Margin="0,0,24,12" />
                        <CheckBox x:Name="OptionsCheck" Style="{StaticResource MtlCheckBox}" IsChecked="True"
                                  Content="游戏设置 (options.txt)" Margin="0,0,24,12" />
                        <CheckBox x:Name="ResourceCheck" Style="{StaticResource MtlCheckBox}" IsChecked="True"
                                  Content="资源包" Margin="0,0,24,12" />
                        <CheckBox x:Name="ShaderCheck" Style="{StaticResource MtlCheckBox}" IsChecked="True"
                                  Content="光影包" Margin="0,0,24,12" />
                        <CheckBox x:Name="SavesCheck" Style="{StaticResource MtlCheckBox}" IsChecked="False"
                                  Content="存档" Margin="0,0,24,12" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="导出格式" Style="{StaticResource H2}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton x:Name="MrpackRadio" Style="{StaticResource SegmentItem}"
                                     GroupName="ExportFormat" Content=".mrpack（Modrinth 整合包）"
                                     IsChecked="True" />
                        <RadioButton x:Name="ZipRadio" Style="{StaticResource SegmentItem}"
                                     GroupName="ExportFormat" Content=".zip（普通压缩包）"
                                     Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="导出…" Width="140"
                                Height="40" Click="Export_Click" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
