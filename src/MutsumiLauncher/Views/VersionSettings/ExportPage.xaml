<UserControl x:Class="MutsumiLauncher.Views.VersionSettings.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <Border Style="{StaticResource GlassCard}" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="整合包名称" Style="{StaticResource FieldLabel}" Margin="0,0,14,0" />
                    <TextBox Grid.Column="1" Style="{StaticResource MtlTextBox}" Text="猫饼镇 beta 1.21.1" />
                    <TextBlock Grid.Column="2" Text="整合包版本" Style="{StaticResource FieldLabel}" Margin="22,0,14,0" />
                    <TextBox Grid.Column="3" Style="{StaticResource MtlTextBox}" Text="1.0.0" Width="120" />
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="导出内容列表" Style="{StaticResource H2}" />

                    <StackPanel Margin="2,16,0,0">
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="游戏本体" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="正式版 1.21.1 · Fabric 0.19.5" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="游戏本体设置" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="键位、音量、视频设置等" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" Margin="28,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="游戏本体个人信息" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="命令历史、已保存的快捷栏" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mod" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="模组" FontSize="12" Foreground="{StaticResource InkMute}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" Margin="28,10,0,0"
                                  Content="已禁用的 Mod" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="Mod 设置" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" Margin="28,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已绘制的地图" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="地图类 Mod 为现有的存档、服务器记录的地图、路标点等" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource MtlCheckBox}" Margin="28,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="JEI 个人信息" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="物品收藏夹等" FontSize="12" Foreground="{StaticResource InkMute}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="资源包" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="纹理包/材质包" FontSize="12" Foreground="{StaticResource InkMute}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="CozyUI+_ysnEX_v1.0a.zip" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="FA+Player-v1.1.zip" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="FA+Player-vJE.zip" />

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="光影包" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Shaders" FontSize="12" Foreground="{StaticResource InkMute}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="光影包设置" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="已选光影包的自定义设置" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="ComplementaryReimagined_r5.9.3.zip" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="photon_v1.3b.zip" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="Solas Shader V3.7b.zip" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0"
                                  Content="UShader_v2.2.zip" />

                        <CheckBox Style="{StaticResource MtlCheckBox}" Margin="0,16,0,0" Content="截图" />
                        <CheckBox Style="{StaticResource MtlCheckBox}" Margin="0,10,0,0"
                                  Content="多人游戏服务器列表" />

                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PCL 启动器程序" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="打包正式版 PCL，以便没有启动器的玩家安装整合包" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource MtlCheckBox}" IsChecked="True" Margin="28,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PCL 个性化内容" FontSize="14" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="功能隐藏设置、主页、背景音乐和图片等" FontSize="12"
                                           Foreground="{StaticResource InkMute}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="高级选项" Style="{StaticResource H2}" />

                    <CheckBox Style="{StaticResource MtlCheckBox}" Margin="2,14,0,0"
                              Content="打包资源文件，以避免在导入时下载" />
                    <CheckBox Style="{StaticResource MtlCheckBox}" Margin="2,10,0,0"
                              Content="仅从 Modrinth 下载资源文件" />

                    <Border Background="#99D9EEF7" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" Foreground="#FF3E5C6E" TextWrapping="Wrap"
                                       Text="配置文件中含有更多高级选项，例如精准控制导出的文件、设置整合包存放位置等。要修改这些选项，请先点击“保存配置”，在编辑配置文件后再导入。" />
                            <Button Grid.Column="1" Style="{StaticResource LinkIconButton}" Content="&#xE711;"
                                    VerticalAlignment="Top" Margin="10,0,0,0" />
                        </Grid>
                    </Border>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="读取配置" Width="130"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="保存配置" Width="130"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="整合包制作指南" Width="150" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0"
                    Height="46" Padding="24,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="开始导出" VerticalAlignment="Center" FontSize="15" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
