<Window x:Class="MutsumiLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mutsumi Launcher"
        Icon="/Assets/app.ico"
        Width="1120" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FocusVisualStyle="{x:Null}">

    <Grid>
        <Border x:Name="Shell" Margin="30" CornerRadius="26" Background="{DynamicResource WindowBase}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270"
                                  Opacity="0.28" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>

            <Grid x:Name="ShellRoot">
                <!-- 背景 -->
                <Image x:Name="Backdrop" Source="{DynamicResource BackdropImage}" Stretch="UniformToFill"
                       Margin="-90" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border Background="{DynamicResource Scrim}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部导航层 -->
                    <Grid x:Name="TitleBar" Grid.Row="0" Margin="18,12,18,0" Height="68"
                          Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                        <Grid x:Name="NavInner">
                            <!-- 导航条本体：收起时就是左上按钮的形状，展开时向右生长成整条 -->
                            <Border x:Name="NavBarSurface" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Width="40" Height="40" CornerRadius="16"
                                    Background="{DynamicResource WindowBar}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                                    IsHitTestVisible="False" />

                            <StackPanel x:Name="NavTabs" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0" IsHitTestVisible="False">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="-6" />
                                </StackPanel.RenderTransform>

                                <RadioButton x:Name="NavLaunch" Style="{StaticResource NavTab}"
                                             GroupName="MainNav" Tag="launch" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="启动" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavDownload" Style="{StaticResource NavTab}"
                                             GroupName="MainNav" Tag="download" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="下载" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}"
                                             GroupName="MainNav" Tag="settings" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="设置" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <Button x:Name="MenuButton" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="MenuButton_Click" ToolTip="导航">
                                <Grid Width="15" Height="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource WindowChrome}"
                                            CornerRadius="1.5" Margin="0,0,3,3" />
                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource WindowChrome}"
                                            CornerRadius="1.5" Margin="3,0,0,3" />
                                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource WindowChrome}"
                                            CornerRadius="1.5" Margin="0,3,3,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource WindowChrome}"
                                            CornerRadius="1.5" Margin="3,3,0,0" />
                                </Grid>
                            </Button>

                            <!-- 右侧按钮的独立底片：展开时溶解，与导航条融为一体 -->
                            <Border x:Name="CloseChrome" Width="40" Height="40" CornerRadius="14"
                                    Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource PanelBorderSoft}" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    IsHitTestVisible="False" />

                            <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="关闭" />
                        </Grid>
                    </Grid>

                    <!-- 页面宿主 -->
                    <ContentControl x:Name="PageHost" Grid.Row="1" />

                    <!-- 版本设置浮层：从底部滑出，覆盖整个窗口（含标题栏） -->
                    <ContentControl x:Name="SettingsHost" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="20"
                                    Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <ContentControl.RenderTransform>
                            <TranslateTransform Y="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- 版本选择浮层 -->
                    <ContentControl x:Name="VersionPickerHost" Grid.Row="0" Grid.RowSpan="2"
                                    Panel.ZIndex="22" Visibility="Collapsed"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <!-- 账号浮层 -->
                    <ContentControl x:Name="AccountHost" Grid.Row="0" Grid.RowSpan="2"
                                    Panel.ZIndex="23" Visibility="Collapsed"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <!-- 下载浮标（离开下载页时显示） -->
                    <Border x:Name="DownloadFloater" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,26,26" Background="{DynamicResource SurfacePanel}" CornerRadius="20"
                            Padding="16,9" Cursor="Hand" Visibility="Collapsed"
                            MouseLeftButtonUp="DownloadFloater_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                              Opacity="0.2" Color="{DynamicResource ShadowColorSoft}" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" Foreground="{DynamicResource AccentDeep}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="FloaterText" Text="下载中" FontSize="12"
                                       Foreground="{DynamicResource Ink}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 启动进度面板（右侧滑出） -->
                    <ContentControl x:Name="LaunchPanelHost" Grid.Row="0" Grid.RowSpan="2"
                                    Panel.ZIndex="26" HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch" Visibility="Collapsed"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="LaunchPanelSlide" X="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- 启动日志查看器 -->
                    <ContentControl x:Name="LogHost" Grid.Row="0" Grid.RowSpan="2"
                                    Panel.ZIndex="25" Visibility="Collapsed"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <!-- 下载任务面板 -->
                    <ContentControl x:Name="DownloadPanelHost" Grid.Row="0" Grid.RowSpan="2"
                                    Panel.ZIndex="24" Visibility="Collapsed"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Grid>

                <!-- 轻提示 -->
                <Border x:Name="Toast" Background="{DynamicResource ToastBg}" CornerRadius="14" Padding="18,9"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                        Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource InkInverse}" FontSize="13" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>