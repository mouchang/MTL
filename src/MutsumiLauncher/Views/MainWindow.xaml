<Window x:Class="MutsumiLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mutsumi Launcher"
        Icon="/Assets/app.ico"
        Width="1120" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Border x:Name="Shell" Margin="30" CornerRadius="26" Background="{StaticResource WindowBase}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270"
                                  Opacity="0.28" Color="#FF1B2B22" />
            </Border.Effect>

            <Grid x:Name="ShellRoot">
                <!-- 背景 -->
                <Image x:Name="Backdrop" Source="/Assets/background.jpg" Stretch="UniformToFill"
                       Margin="-90" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border Background="{StaticResource Scrim}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid x:Name="TitleBar" Grid.Row="0" Margin="26,12,26,0" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                        <Button x:Name="MenuButton" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Click="MenuButton_Click">
                            <Grid Width="15" Height="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="#FF35473C"
                                        CornerRadius="1.5" Margin="0,0,3,3" />
                                <Border Grid.Row="0" Grid.Column="1" Background="#FF35473C"
                                        CornerRadius="1.5" Margin="3,0,0,3" />
                                <Border Grid.Row="1" Grid.Column="0" Background="#FF35473C"
                                        CornerRadius="1.5" Margin="0,3,3,0" />
                                <Border Grid.Row="1" Grid.Column="1" Background="#FF35473C"
                                        CornerRadius="1.5" Margin="3,3,0,0" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="NavTabs" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Visibility="Collapsed">
                            <RadioButton x:Name="NavLaunch" Style="{StaticResource NavTab}"
                                         GroupName="MainNav" Tag="launch" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="启动" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDownload" Style="{StaticResource NavTab}"
                                         GroupName="MainNav" Tag="download" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="下载" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}"
                                         GroupName="MainNav" Tag="settings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Content="&#xE8BB;" Click="CloseButton_Click" />
                    </Grid>

                    <!-- 页面宿主 -->
                    <ContentControl x:Name="PageHost" Grid.Row="1" />
                </Grid>

                <!-- 轻提示 -->
                <Border x:Name="Toast" Background="#E62E3E35" CornerRadius="14" Padding="18,9"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                        Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="#FFF7FBF4" FontSize="13" />
                </Border>
            </Grid>
        </Border>

        <!-- 汉堡菜单 -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="8">
            <Border Background="#F7FFFFFF" CornerRadius="16" Padding="8" Width="228" Margin="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                      Opacity="0.18" Color="#FF1B2B22" />
                </Border.Effect>
                <StackPanel>
                    <Button Style="{StaticResource MenuItemButton}" Tag="launch" Click="MenuNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                            <TextBlock Text="启动" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItemButton}" Tag="download" Click="MenuNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                            <TextBlock Text="下载" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItemButton}" Tag="settings" Click="MenuNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="#22000000" Margin="8,6" />

                    <Button Style="{StaticResource MenuItemButton}" Click="MenuAbout_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                            <TextBlock Text="关于 MTL" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItemButton}" Click="MenuMinimize_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                            <TextBlock Text="最小化" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItemButton}" Click="MenuExit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                            <TextBlock Text="退出" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
