<UserControl x:Class="MutsumiLauncher.Views.VersionPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid x:Name="Root" Background="#33000000" Opacity="0" MouseDown="Backdrop_MouseDown">
        <Border x:Name="Card" VerticalAlignment="Bottom" Margin="28,0,28,28" CornerRadius="22"
                Background="#F9FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.22"
                                  Color="#FF2E4A38" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="420" />
            </Border.RenderTransform>

            <StackPanel>
                <Grid>
                    <TextBlock Text="选择启动版本" Style="{StaticResource H1}" />
                    <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                            Content="&#xE711;" Click="Close_Click" ToolTip="关闭" />
                </Grid>

                <TextBlock Text="点击一个版本即可切换，选择会被记住。" Style="{StaticResource Caption}"
                           Margin="0,4,0,0" />

                <ScrollViewer MaxHeight="300" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="VersionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Padding="14,10"
                                        Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                                        Tag="{Binding}" Click="Version_Click">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontSize="15"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="已安装" FontSize="11"
                                                       Foreground="{StaticResource InkMute}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" Foreground="{StaticResource AccentDeep}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Text="还没有安装任何版本，先去下载页装一个吧。"
                           Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
