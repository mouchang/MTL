<Window x:Class="MutsumiLauncher.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mutsumi Launcher"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="24">
        <Border Background="{DynamicResource SurfaceFloat}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270"
                                  Opacity="0.25" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
            <StackPanel Margin="24,20,24,20">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" />
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="{DynamicResource InkSoft}"
                           Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消"
                            Width="88" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="确定"
                            Width="88" Click="Ok_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>