<UserControl x:Class="MutsumiLauncher.Views.DownloadPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Background="#33000000" MouseDown="Backdrop_MouseDown">
        <Border VerticalAlignment="Bottom" Margin="28,0,28,28" CornerRadius="22"
                Background="#F9FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.22"
                                  Color="#FF2E4A38" />
            </Border.Effect>

            <StackPanel>
                <Grid>
                    <TextBlock Text="下载任务" Style="{StaticResource H1}" />
                    <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                            Content="&#xE711;" Click="Close_Click" ToolTip="关闭" />
                </Grid>

                <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,4,0,10" />

                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="14"
                                                       Foreground="{StaticResource Ink}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="取消" Style="{StaticResource GhostButton}"
                                                        Height="24" Padding="10,0" FontSize="11"
                                                        Margin="0,0,8,0" Tag="{Binding}"
                                                        Visibility="{Binding CancelVisibility}"
                                                        Click="CancelTask_Click" />
                                                <Button Content="重试" Style="{StaticResource GhostButton}"
                                                        Height="24" Padding="10,0" FontSize="11"
                                                        Margin="0,0,8,0" Tag="{Binding}"
                                                        Visibility="{Binding RetryVisibility}"
                                                        Click="RetryTask_Click" />
                                                <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                           Foreground="{StaticResource AccentDeep}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}"
                                                           FontSize="11" Foreground="{StaticResource InkMute}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Value="{Binding Percent}" Maximum="100" Height="4"
                                                     Margin="0,6,0,0" IsIndeterminate="{Binding Indeterminate}">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid Background="#33FFFFFF" ClipToBounds="True">
                                                        <Border x:Name="PART_Track" />
                                                        <Border x:Name="PART_Indicator"
                                                                Background="{StaticResource AccentDeep}"
                                                                HorizontalAlignment="Left" CornerRadius="2" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>

                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   Foreground="{StaticResource InkMute}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
