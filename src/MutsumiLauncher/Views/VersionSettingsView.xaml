<UserControl x:Class="MutsumiLauncher.Views.VersionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Border Background="#F2F7FBF4" ClipToBounds="True">
        <Grid>
            <Image Source="/Assets/background.jpg" Stretch="UniformToFill" Margin="-90">
                <Image.Effect>
                    <BlurEffect Radius="34" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <Border Background="#40FFFFFF" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 浮层自己的标题栏：标题 + 关闭（拖动整窗） -->
                <Grid Grid.Row="0" Margin="26,12,26,0" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Text="版本设置" FontSize="16"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                               Margin="0,0,60,0" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="Close_Click" ToolTip="关闭" />
                </Grid>

                <Grid Grid.Row="1" Margin="18,0,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#4DFFFFFF" CornerRadius="18" Padding="10">
                        <StackPanel>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="overview" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="概览" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="launch" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="mods" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="Mod 管理" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="saves" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="存档" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="export" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="导出" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="PageHost" Grid.Column="1" Margin="16,0,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
