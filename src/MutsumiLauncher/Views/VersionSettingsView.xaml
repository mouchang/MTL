<UserControl x:Class="MutsumiLauncher.Views.VersionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Border Background="{DynamicResource PaneBg}" ClipToBounds="True">
        <Grid>
            <Image Source="{DynamicResource BackdropImage}" Stretch="UniformToFill" Margin="-90">
                <Image.Effect>
                    <BlurEffect Radius="34" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <Border Background="{DynamicResource BackdropVeil}" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 浮层自己的标题栏：标题 + 关闭（拖动整窗） -->
                <Grid Grid.Row="0" Margin="26,12,26,0" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Text="版本设置" FontSize="16"
                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                               Margin="0,0,60,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button Style="{StaticResource GhostButton}" Content="引用 .minecraft…"
                                Height="28" Padding="12,0" Margin="0,2,10,0"
                                Click="ReferenceMinecraft_Click"
                                ToolTip="引用其它启动器里已有的版本，不复制文件" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                                VerticalAlignment="Top" Click="Close_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="18,0,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource SidebarBg}" CornerRadius="18" Padding="10">
                        <StackPanel x:Name="NavPanel">
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="overview" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="概览" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="launch" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="mods" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="Mod 管理" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="saves" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="存档" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                         Tag="export" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock Text="导出" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <ContentControl x:Name="PageHost" />

                        <!-- 一个版本都没有时显示，引导用户下载 / 引用 -->
                        <Border x:Name="EmptyState" Visibility="Collapsed"
                                Background="{DynamicResource PaneBg}" CornerRadius="18">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="420">
                                <TextBlock Text="还没有可用的版本" FontSize="18"
                                           Foreground="{DynamicResource Ink}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="先在「下载」里安装一个，或者引用其它启动器已有的 .minecraft。"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,18,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="去下载"
                                            Height="36" Width="120" Click="GoDownload_Click" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="引用 .minecraft…"
                                            Height="36" Padding="16,0" Margin="12,0,0,0"
                                            Click="ReferenceMinecraft_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>