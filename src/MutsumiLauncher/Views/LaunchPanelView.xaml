<UserControl x:Class="MutsumiLauncher.Views.LaunchPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="22,0,0,22" Background="{DynamicResource SurfaceFloat}" BorderBrush="{DynamicResource PanelBorderSoft}"
            BorderThickness="1,0,0,0" Padding="24,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Direction="180" Opacity="0.18"
                              Color="{DynamicResource ShadowColorSoft}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="TitleText" Text="启动游戏" Style="{StaticResource H1}" />
                <Button Style="{StaticResource LinkIconButton}" HorizontalAlignment="Right"
                        Content="&#xE711;" Click="Close_Click" ToolTip="关闭面板" />
            </Grid>

            <TextBlock x:Name="SubtitleText" Grid.Row="1" Style="{StaticResource Caption}"
                       Margin="0,4,0,12" Text="正在准备启动…" />

            <!-- 进度 -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="StatusText" Text="准备中…" FontSize="13"
                                   Foreground="{DynamicResource Ink}" />
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="13"
                                   Foreground="{DynamicResource AccentDeep}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid x:Name="ProgressTrack" Height="6" Margin="0,10,0,0" ClipToBounds="True">
                        <Border Background="{DynamicResource OverlayWash}" CornerRadius="3" />
                        <Border x:Name="ProgressFill" Background="{DynamicResource AccentDeep}"
                                CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 运行信息 + 实时日志 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <Border Style="{StaticResource GlassCard}" Padding="18,16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="运行信息" Style="{StaticResource H2}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="实例" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="InstanceText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource InkSoft}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Java" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="JavaText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource InkSoft}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进程" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="ProcessText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource InkSoft}" Text="—" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日志" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="LogText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource InkSoft}" TextTrimming="CharacterEllipsis"
                                   Text="—" />
                    </Grid>
                </StackPanel>
            </Border>

                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,12,0,0"
                        MinHeight="180">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="实时日志" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogBody" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 操作 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="KillButton" Style="{StaticResource DangerButton}" Content="强制关闭"
                        Width="130" IsEnabled="False" Click="Kill_Click" />
                <Button Style="{StaticResource SecondaryButton}" Content="关闭面板"
                        Width="120" Margin="10,0,0,0" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>