<Window x:Class="MutsumiLauncher.Views.VersionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本设置"
        Icon="/Assets/app.ico"
        Width="1080" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Border x:Name="Shell" Margin="26" CornerRadius="24" Background="{StaticResource WindowBase}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270"
                                  Opacity="0.28" Color="#FF1B2B22" />
            </Border.Effect>

            <Grid>
                <Image Source="/Assets/background.jpg" Stretch="UniformToFill" Margin="-90">
                    <Image.Effect>
                        <BlurEffect Radius="30" KernelType="Gaussian" />
                    </Image.Effect>
                </Image>
                <Border Background="#40FFFFFF" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Margin="18,10,18,0" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="Close_Click" ToolTip="返回" />
                        <TextBlock x:Name="TitleText" Text="版本设置 · 猫饼镇 beta 1.21.1"
                                   FontSize="16" Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center" Margin="54,0,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                                    Click="Minimize_Click" ToolTip="最小化" />
                            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                                    Margin="8,0,0,0" Click="Close_Click" ToolTip="关闭" />
                        </StackPanel>
                    </Grid>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="18,6,18,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#4DFFFFFF" CornerRadius="18" Padding="10">
                            <StackPanel>
                                <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                             Tag="overview" IsChecked="True" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                        <TextBlock Text="概览" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                             Tag="launch" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                        <TextBlock Text="设置" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                             Tag="mods" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                        <TextBlock Text="Mod 管理" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SidebarItem}" GroupName="SettingsNav"
                                             Tag="export" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                        <TextBlock Text="导出" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="16,0,0,0" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
