<?xml version="1.0" encoding="utf-8"?>
<!--
    明亮主题色板。运行时由 Services/ThemeService.cs 整份替换：
    切换主题时会把这个字典从 Application.Resources 里摘掉，换成算出来的新色板。
    新增颜色时两边都要加（ThemeService 启动时会做一次键集合校验，缺了会写日志）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 文字 -->
    <SolidColorBrush x:Key="Ink" Color="#FF2E3E35" />
    <SolidColorBrush x:Key="InkStrong" Color="#FF1E2C24" />
    <SolidColorBrush x:Key="InkMax" Color="#FF0F1712" />
    <SolidColorBrush x:Key="InkSoft" Color="#FF5C6F63" />
    <SolidColorBrush x:Key="InkMute" Color="#FF86988C" />
    <SolidColorBrush x:Key="InkInverse" Color="#FFF7FBF4" />
    <SolidColorBrush x:Key="InkOnAccent" Color="#FF27452F" />

    <!-- 主色（薄荷绿） -->
    <SolidColorBrush x:Key="Accent" Color="#FF8FD8A8" />
    <SolidColorBrush x:Key="AccentDeep" Color="#FF4E9E72" />
    <SolidColorBrush x:Key="AccentWash" Color="#FFB8E9C6" />
    <SolidColorBrush x:Key="AccentTint" Color="#FFE6F2E8" />
    <SolidColorBrush x:Key="AccentTintDeep" Color="#FFC9EDD5" />
    <SolidColorBrush x:Key="AccentTintSoft" Color="#FFDCEFE0" />
    <SolidColorBrush x:Key="PrimaryFill" Color="#FF3F8E63" />
    <SolidColorBrush x:Key="PrimaryFillHover" Color="#FF357A55" />

    <!-- 玻璃质感 -->
    <SolidColorBrush x:Key="Glass" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="GlassMedium" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="GlassStrong" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="GlassHover" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="GlassHoverSoft" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="GlassStroke" Color="#78FFFFFF" />
    <SolidColorBrush x:Key="HoverWash" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="OverlayWash" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="TrackBg" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ChipBg" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="RingStroke" Color="#99FFFFFF" />

    <!-- 窗口与浮层 -->
    <SolidColorBrush x:Key="WindowBase" Color="#FFF7FBF4" />
    <SolidColorBrush x:Key="WindowChrome" Color="#FF35473C" />
    <SolidColorBrush x:Key="WindowBar" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="WindowBorder" Color="#85FFFFFF" />
    <SolidColorBrush x:Key="PaneBg" Color="#F2F7FBF4" />
    <SolidColorBrush x:Key="SurfacePanel" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SurfaceFloat" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSolid" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SidebarBg" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="AvatarCard" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="PillBg" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="ToastBg" Color="#E62E3E35" />
    <SolidColorBrush x:Key="ModalScrim" Color="#33000000" />
    <SolidColorBrush x:Key="Scrim" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BackdropVeil" Color="#40FFFFFF" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="CardBorder" Color="#88FFFFFF" />
    <SolidColorBrush x:Key="PanelBorderSoft" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="DialogHairline" Color="#1A000000" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="Danger" Color="#FFC0392B" />
    <SolidColorBrush x:Key="DangerInk" Color="#FFB03A2E" />
    <SolidColorBrush x:Key="DangerDeep" Color="#FF8E2A27" />
    <SolidColorBrush x:Key="DangerWash" Color="#FFF4E5E5" />
    <SolidColorBrush x:Key="DangerWashSoft" Color="#22C0392B" />
    <SolidColorBrush x:Key="DangerWashBorder" Color="#66C0392B" />
    <SolidColorBrush x:Key="InfoTint" Color="#FFD9EEF7" />
    <SolidColorBrush x:Key="InfoInk" Color="#FF3E5C6E" />
    <SolidColorBrush x:Key="SourceGreen" Color="#FF3F7F5C" />
    <SolidColorBrush x:Key="SourceOrange" Color="#FFB45F1B" />

    <!-- 阴影 -->
    <SolidColorBrush x:Key="ShadowTint" Color="#FF1B2B22" />
    <Color x:Key="ShadowColor">#FF1B2B22</Color>
    <Color x:Key="ShadowColorSoft">#FF2E4A38</Color>

</ResourceDictionary>
