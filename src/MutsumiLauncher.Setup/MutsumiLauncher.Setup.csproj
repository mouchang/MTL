<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MTLSetup</AssemblyName>
    <RootNamespace>MutsumiLauncher.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\MutsumiLauncher\Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
    <Version>0.1.0</Version>
    <Company>Mutsumi</Company>
    <Product>Mutsumi Launcher Setup</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\MutsumiLauncher-0.1.0-win-x64.zip" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
