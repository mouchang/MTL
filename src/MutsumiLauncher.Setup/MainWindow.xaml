<Window x:Class="MutsumiLauncher.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mutsumi Launcher 安装程序" Width="720" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="22" Background="#F3FAF6" BorderBrush="#B9E3C9" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.22"
                              Color="#FF2E4A38" />
        </Border.Effect>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F7FCF8" Offset="0" />
                    <GradientStop Color="#E6F6EC" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Margin="24,10,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#FF8FD8A8">
                        <TextBlock Text="M" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Mutsumi Launcher" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#FF2E3E35" />
                        <TextBlock x:Name="SubtitleText" Text="安装程序 · 0.1.0" FontSize="11"
                                   Foreground="#FF6B7F72" />
                    </StackPanel>
                </StackPanel>

                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34"
                        Cursor="Hand" Click="Close_Click" Background="Transparent" BorderThickness="0"
                        Foreground="#FF4E9E72" />
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="28,6,28,0">
                <TextBlock Text="选择安装位置" FontSize="20" FontWeight="SemiBold"
                           Foreground="#FF2E3E35" Margin="0,6,0,4" />
                <TextBlock Text="安装器会把启动器完整安装到下面的文件夹，安装目录可以自己选择。"
                           FontSize="12" Foreground="#FF6B7F72" TextWrapping="Wrap" Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#FAFFFFFF" CornerRadius="12" BorderBrush="#FFCDE7D6"
                            BorderThickness="1" Padding="12,0" Height="42">
                        <TextBox x:Name="DirBox" BorderThickness="0" Background="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 Foreground="#FF2E3E35" TextChanged="DirBox_TextChanged" />
                    </Border>

                    <Button Grid.Column="1" Content="浏览…" Width="92" Height="42" Margin="10,0,0,0"
                            Cursor="Hand" Click="Browse_Click" Background="#FFFFFFFF"
                            BorderBrush="#FFCDE7D6" BorderThickness="1" Foreground="#FF2E3E35"
                            FontSize="13" />
                </Grid>

                <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式"
                          IsChecked="True" Margin="2,16,0,0" FontSize="13"
                          Foreground="#FF2E3E35" />

                <CheckBox x:Name="StartMenuCheck" Content="创建开始菜单快捷方式"
                          IsChecked="True" Margin="2,10,0,0" FontSize="13"
                          Foreground="#FF2E3E35" />

                <Border Background="#FAFFFFFF" CornerRadius="12" BorderBrush="#FFCDE7D6"
                        BorderThickness="1" Padding="14,10" Margin="0,18,0,0">
                    <TextBlock x:Name="StatusText" Text="准备就绪，点击「安装」开始。"
                               FontSize="12" Foreground="#FF4E9E72" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- 底部 -->
            <Grid Grid.Row="2" Margin="28,14,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Height="6" ClipToBounds="True">
                    <Border Background="#FFE2F1E8" CornerRadius="3" />
                    <Border x:Name="ProgressFill" Background="#FF4E9E72" CornerRadius="3"
                            HorizontalAlignment="Left" Width="0" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="OpenButton" Content="打开安装目录" Width="130" Height="42"
                            Margin="0,0,10,0" Visibility="Collapsed" Cursor="Hand"
                            Click="Open_Click" Background="#FFFFFFFF" BorderBrush="#FFCDE7D6"
                            BorderThickness="1" Foreground="#FF2E3E35" FontSize="13" />

                    <Button x:Name="InstallButton" Content="安装" Width="130" Height="42"
                            Cursor="Hand" Click="Install_Click" Background="#FF4E9E72"
                            BorderThickness="0" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
