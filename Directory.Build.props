<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.1-beta.12</Version>
    <FileVersion>1.1.1.12</FileVersion>
    <InformationalVersion>MTL beta v1.1.1 build 12</InformationalVersion>
    <Company>Mutsumi</Company>
    <Product>Mutsumi Launcher</Product>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 程序集版本（AssemblyVersion）存不下 -beta 这类后缀，单独写一份完整版本给更新检查用 -->
    <AssemblyMetadata Include="Version" Value="$(Version)" />
  </ItemGroup>
</Project>
